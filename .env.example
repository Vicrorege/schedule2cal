BOT_TOKEN=123456789:REPLACE_ME
ALLOWED_USERS=123456789

# Optional SOCKS5 proxy for Telegram + LLM
# PROXY=socks5://127.0.0.1:10808

# LLM: gemini | openai
LLM_PROVIDER=gemini
# Один ключ или пул через запятую (разные проекты = разные free-квоты)
LLM_API_KEY=REPLACE_ME_KEY1,REPLACE_ME_KEY2
# Или отдельно:
# LLM_API_KEYS=key3,key4
# LLM_MODEL=gemini-3.6-flash

# Optional SQLite path
# DATABASE_PATH=data/schedule2cal.db
