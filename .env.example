BOT_TOKEN=123456789:REPLACE_ME
ALLOWED_USERS=123456789

# Optional SOCKS5 proxy for Telegram + LLM
# PROXY=socks5://127.0.0.1:10808

# gemini = нативный Google GenAI; openai = только кастомные слоты
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash

# Нативные Gemini-ключи (обычный endpoint Google)
LLM_API_KEY=AQ.key1,AQ.key2

# Кастомные слоты: key|base_url|model (через ;)
LLM_POOL=sk-REPLACE|https://example.com/v1|agy/gemini-3.7-flash-high;sk-REPLACE|https://example.com/v1|agy/gemini-3.7-flash-medium;sk-REPLACE|https://example.com/v1|agy/gemini-3.7-flash-low

# Optional SQLite path
# DATABASE_PATH=data/schedule2cal.db
